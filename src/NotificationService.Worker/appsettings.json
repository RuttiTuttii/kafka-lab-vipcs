{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "NotificationService.Worker": "Information"
    }
  },
  "Kafka": {
    "BootstrapServers": "10.9.2.80:9092",
    "GroupId": "notification-service",
    "TopicSuffix": "",
    "AutoOffsetReset": "Earliest",
    "Topics": [
      "order.created",
      "payment.completed",
      "payment.failed",
      "order.cancelled",
      "order.status.changed"
    ]
  },
  "Persistence": {
    "StoragePath": "data/notifications-history.json"
  }
}
