{
  "$schema": "https://json.schemastore.org/launchsettings.json",
  "profiles": {
    "NotificationService.Worker (college broker 10.9.2.80:9092)": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "environmentVariables": {
        "DOTNET_ENVIRONMENT": "Development",
        "ASPNETCORE_ENVIRONMENT": "Development",
        "Kafka__BootstrapServers": "10.9.2.80:9092"
      }
    },
    "NotificationService.Worker (local broker localhost:9092)": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "environmentVariables": {
        "DOTNET_ENVIRONMENT": "Development",
        "ASPNETCORE_ENVIRONMENT": "Development",
        "Kafka__BootstrapServers": "localhost:9092"
      }
    },
    "NotificationService.Worker (broker from appsettings.Local.json)": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "environmentVariables": {
        "DOTNET_ENVIRONMENT": "Development",
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    }
  }
}
